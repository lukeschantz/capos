{
  "name": "capital-os",
  "version": "0.1.0",
  "description": "Intelligence & Orchestration Platform - Strawman Prototype",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:mcp": "python backend/mcp-server/server.py",
    "dev:agents": "python cli.py",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:mcp\"",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run start",
    "test:python": "pytest tests/",
    "test:frontend": "cd frontend && npm test",
    "setup": "./scripts/setup.sh",
    "install:all": "npm install && cd frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.10"
  }
}
