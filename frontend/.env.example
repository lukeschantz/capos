# Capital OS Frontend Environment Variables

# MCP Server
NEXT_PUBLIC_MCP_SERVER_URL=http://localhost:8000

# Supabase (Optional - for auth in Phase 2)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Neo4j (Optional - for knowledge graph in Phase 3)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Feature Flags
NEXT_PUBLIC_ENABLE_VC_MODULE=true
NEXT_PUBLIC_ENABLE_NOTE_INTELLIGENCE=false
NEXT_PUBLIC_ENABLE_KNOWLEDGE_GRAPH=false
