# LLM Provider API Keys
# Choose one or more providers based on your needs

# OpenAI (GPT-4, GPT-3.5)
OPENAI_API_KEY=sk-...

# Anthropic (Claude 3.5 Sonnet, Claude 3 Haiku)
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini)
GOOGLE_API_KEY=...

# LangSmith (for monitoring and observability)
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=vc-digital-twin
LANGSMITH_TRACING_V2=true

# Tavily (for web search)
TAVILY_API_KEY=tvly-...

# Database (for state persistence)
DATABASE_URL=postgresql://user:password@localhost:5432/vc_digital_twin

# Application settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Model selection (default models for each tier)
SUPERVISOR_MODEL=gpt-4o  # or claude-3-5-sonnet-20241022
WORKER_MODEL=gpt-4o-mini  # or claude-3-5-haiku-20241022
EMBEDDING_MODEL=text-embedding-3-small

# Configuration
CONFIG_PATH=config/investment_thesis.yaml

# API settings (for future web interface)
API_HOST=0.0.0.0
API_PORT=8000

# Rate limiting and cost controls
MAX_TOKENS_PER_REQUEST=4096
MAX_CONCURRENT_AGENTS=5
MONTHLY_BUDGET_USD=1000
